PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tizbor_sanat
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h

# comma-separated list of origins allowed to call this API (the frontend's URL(s))
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# used only by the node-pg-migrate CLI (npm run migrate:*) — same database as DB_* above
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/tizbor_sanat
